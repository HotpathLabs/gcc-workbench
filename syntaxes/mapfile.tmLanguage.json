{
 "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
 "name": "Linker Map File",
 "scopeName": "source.mapfile",
 "patterns": [
  {
   "include": "#lines"
  }
 ],
 "repository": {
  "headers": {
   "patterns": [
    {
     "match": "^(Memory Configuration|Linker script and memory map|Discarded input sections|Archive member included to satisfy reference by file \\(symbol\\)|Allocating common symbols|Cross Reference Table)\\s*$",
     "captures": {
      "1": {
       "name": "markup.heading.mapfile"
      }
     }
    },
    {
     "match": "^(Common\\s+symbol\\s+size\\s+file|Symbol\\s+File)\\s*$",
     "captures": {
      "1": {
       "name": "markup.underline.table-header.mapfile"
      }
     }
    }
   ]
  },
  "memory-config": {
   "begin": "^Name\\s+Origin\\s+Length\\s+Attributes\\s*$",
   "end": "^\\s*$",
   "beginCaptures": {
    "0": {
     "name": "markup.underline.table-header.mapfile"
    }
   },
   "patterns": [
    {
     "match": "^(\\*default\\*)\\s+(0x[0-9a-fA-F]+)\\s+(0x[0-9a-fA-F]+)",
     "captures": {
      "1": {
       "name": "constant.language.default.mapfile"
      },
      "2": {
       "name": "constant.numeric.address.mapfile"
      },
      "3": {
       "name": "constant.numeric.size.mapfile"
      }
     }
    },
    {
     "match": "^(\\S+)\\s+(0x[0-9a-fA-F]+)\\s+(0x[0-9a-fA-F]+)(?:\\s+([rwxaliRWXALI!]+))?",
     "captures": {
      "1": {
       "name": "entity.name.type.region.mapfile"
      },
      "2": {
       "name": "constant.numeric.address.mapfile"
      },
      "3": {
       "name": "constant.numeric.size.mapfile"
      },
      "4": {
       "name": "storage.modifier.attribute.mapfile"
      }
     }
    }
   ]
  },
  "objref": {
   "patterns": [
    {
     "match": "((?:[A-Za-z]:)?(?:[\\w.+~@-]*[/\\\\])*)([\\w.+~@-]+\\.a)(\\()([^)]+)(\\))",
     "captures": {
      "1": {
       "name": "string.unquoted.directory.mapfile"
      },
      "2": {
       "name": "entity.name.filename.library.mapfile"
      },
      "3": {
       "name": "punctuation.parens.mapfile"
      },
      "4": {
       "name": "entity.name.filename.object.mapfile"
      },
      "5": {
       "name": "punctuation.parens.mapfile"
      }
     }
    },
    {
     "match": "((?:[A-Za-z]:)?(?:[\\w.+~@-]*[/\\\\])*)([\\w.+~@-]+\\.so(?:\\.\\d+)*)",
     "captures": {
      "1": {
       "name": "string.unquoted.directory.mapfile"
      },
      "2": {
       "name": "entity.name.filename.shared.mapfile"
      }
     }
    },
    {
     "match": "((?:[A-Za-z]:)?(?:[\\w.+~@-]*[/\\\\])*)([\\w.+~@-]+\\.a)\\b",
     "captures": {
      "1": {
       "name": "string.unquoted.directory.mapfile"
      },
      "2": {
       "name": "entity.name.filename.library.mapfile"
      }
     }
    },
    {
     "match": "((?:[A-Za-z]:)?(?:[\\w.+~@-]*[/\\\\])*)([\\w.+~@-]+\\.(?:o|obj|lo|lib))\\b",
     "captures": {
      "1": {
       "name": "string.unquoted.directory.mapfile"
      },
      "2": {
       "name": "entity.name.filename.object.mapfile"
      }
     }
    },
    {
     "match": "((?:[A-Za-z]:)?(?:[\\w.+~@-]*[/\\\\])+)([\\w.+~@-]+)",
     "captures": {
      "1": {
       "name": "string.unquoted.directory.mapfile"
      },
      "2": {
       "name": "entity.name.filename.object.mapfile"
      }
     }
    },
    {
     "match": "\\[!?(?:provide|hidden|weak)\\]|\\(size before relaxing\\)|\\(--[^)]*\\)|\\blinker stubs\\b",
     "name": "comment.line.annotation.mapfile"
    }
   ]
  },
  "expr": {
   "patterns": [
    {
     "match": "\\[!?(?:provide|hidden|weak)\\]|\\(size before relaxing\\)|\\blinker stubs\\b",
     "name": "comment.line.annotation.mapfile"
    },
    {
     "match": "\"[^\"]*\"",
     "name": "string.quoted.double.mapfile"
    },
    {
     "match": "\\b(ALIGN|ALIGNOF|ABSOLUTE|ADDR|ASSERT|BLOCK|CONSTANT|DATA_SEGMENT_ALIGN|DATA_SEGMENT_END|DATA_SEGMENT_RELRO_END|DEFINED|LENGTH|LOADADDR|LOG2CEIL|MAX|MIN|NEXT|ORIGIN|SEGMENT_START|SIZEOF|SORT|SORT_BY_ALIGNMENT|SORT_BY_INIT_PRIORITY|SORT_BY_NAME|SORT_NONE|EXCLUDE_FILE|KEEP|NOLOAD|FILL|AT|ONLY_IF_RO|ONLY_IF_RW|SUBALIGN)\\b(?=\\s*\\()",
     "name": "support.function.linker.mapfile"
    },
    {
     "match": "\\b(NEXT_SECTION|MAXPAGESIZE|COMMONPAGESIZE|SIZEOF_HEADERS|LARGE_COMMON|COMMON|CONSTRUCTORS)\\b",
     "name": "support.constant.linker.mapfile"
    },
    {
     "match": "\\b(PROVIDE_HIDDEN|PROVIDE|HIDDEN|LOAD|OUTPUT|INPUT|GROUP|AS_NEEDED|ENTRY|EXTERN|INSERT|STARTUP|TARGET|SEARCH_DIR|START GROUP|END GROUP)\\b",
     "name": "keyword.control.linker.mapfile"
    },
    {
     "match": "\\b0x[0-9a-fA-F]+\\b",
     "name": "constant.numeric.address.mapfile"
    },
    {
     "match": "\\b\\d+[KkMm]?\\b",
     "name": "constant.numeric.size.mapfile"
    },
    {
     "match": "(?<![\\w.$])\\.(?![\\w.$])",
     "name": "variable.language.location-counter.mapfile"
    },
    {
     "match": "\\b(__\\w+|_GLOBAL_OFFSET_TABLE_|_DYNAMIC|_edata|edata|_end|end|_etext|etext|_start|_init|_fini|data_start|_IO_stdin_used|_sdata|_sidata|_sbss|_ebss|_stext|_estack|_stack|_heap|_Min_Heap_Size|_Min_Stack_Size|_etext)\\b",
     "name": "support.variable.builtin.mapfile"
    },
    {
     "match": "(?<![\\w.$])\\.[A-Za-z_][\\w.$-]*",
     "name": "entity.name.section.input.mapfile"
    },
    {
     "match": "[+\\-*/%&|^~!<>=?:]+",
     "name": "keyword.operator.mapfile"
    },
    {
     "match": "[(),;]",
     "name": "punctuation.separator.mapfile"
    }
   ]
  },
  "sym-ref": {
   "patterns": [
    {
     "match": "(?<![\\w.$])(?:__\\w+|_GLOBAL_OFFSET_TABLE_|_DYNAMIC|_edata|edata|_end|end|_etext|etext|_start|_init|_fini|data_start|_IO_stdin_used|_sdata|_sidata|_sbss|_ebss|_stext|_estack|_stack|_heap|_Min_Heap_Size|_Min_Stack_Size|_etext)(?![\\w.$@])",
     "name": "support.variable.builtin.mapfile"
    },
    {
     "match": "([\\w.$]+)(@@?[\\w.]+)",
     "captures": {
      "1": {
       "name": "entity.name.function.imported.mapfile"
      },
      "2": {
       "name": "variable.other.version.mapfile"
      }
     }
    },
    {
     "match": "[\\w.$]+",
     "name": "entity.name.function.symbol.mapfile"
    }
   ]
  },
  "apple-name": {
   "patterns": [
    {
     "match": "\\b(?:literal string|FDE for|CFI|\\d+-byte-literal)\\b:?",
     "name": "comment.line.annotation.mapfile"
    },
    {
     "match": "%[-+ #0]*\\d*(?:\\.\\d+)?[a-zA-Z]|\\\\[nrt]",
     "name": "constant.character.escape.mapfile"
    },
    {
     "include": "#sym-ref"
    }
   ]
  },
  "glob": {
   "patterns": [
    {
     "match": "\\b(?:ALIGN|ALIGNOF|ABSOLUTE|ADDR|ASSERT|BLOCK|CONSTANT|DATA_SEGMENT_ALIGN|DATA_SEGMENT_END|DATA_SEGMENT_RELRO_END|DEFINED|LENGTH|LOADADDR|LOG2CEIL|MAX|MIN|NEXT|ORIGIN|SEGMENT_START|SIZEOF|SORT|SORT_BY_ALIGNMENT|SORT_BY_INIT_PRIORITY|SORT_BY_NAME|SORT_NONE|EXCLUDE_FILE|KEEP|NOLOAD|FILL|AT|ONLY_IF_RO|ONLY_IF_RW|SUBALIGN)\\b(?=\\s*\\()",
     "name": "support.function.linker.mapfile"
    },
    {
     "match": "\\b(?:NEXT_SECTION|MAXPAGESIZE|COMMONPAGESIZE|SIZEOF_HEADERS|LARGE_COMMON|COMMON|CONSTRUCTORS)\\b",
     "name": "support.constant.linker.mapfile"
    },
    {
     "match": "\\*?[\\w.+~-]*(?:\\*|\\?)[\\w.*?+~-]*\\.(?:o|obj|a)\\b|\\*[\\w?.+~-]*\\.(?:o|obj|a)\\b",
     "name": "entity.name.filename.object.mapfile"
    },
    {
     "match": "\\.[\\w.$*?\\[\\]-]+",
     "name": "entity.name.section.input.mapfile"
    },
    {
     "match": "\\*",
     "name": "keyword.operator.mapfile"
    },
    {
     "match": "[()]",
     "name": "punctuation.parens.mapfile"
    }
   ]
  },
  "lines": {
   "patterns": [
    {
     "include": "#headers"
    },
    {
     "include": "#memory-config"
    },
    {
     "match": "^(OUTPUT)(\\()(.*)(\\))\\s*$",
     "captures": {
      "1": {
       "name": "keyword.control.linker.mapfile"
      },
      "2": {
       "name": "punctuation.parens.mapfile"
      },
      "3": {
       "name": "string.unquoted.mapfile"
      },
      "4": {
       "name": "punctuation.parens.mapfile"
      }
     }
    },
    {
     "match": "^(LOAD)\\s+(.+)$",
     "captures": {
      "1": {
       "name": "keyword.control.linker.mapfile"
      },
      "2": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      }
     }
    },
    {
     "match": "^(START GROUP|END GROUP)\\s*$",
     "captures": {
      "1": {
       "name": "keyword.control.linker.mapfile"
      }
     }
    },
    {
     "match": "^((?:Updated|Removed) property\\b.*)$",
     "captures": {
      "1": {
       "name": "comment.line.annotation.mapfile"
      }
     }
    },
    {
     "match": "^\\s*(\\*fill\\*)\\s+(0x[0-9a-fA-F]+)\\s+(0x[0-9a-fA-F]+)(?:\\s+([0-9a-fA-F]+))?",
     "captures": {
      "1": {
       "name": "comment.line.annotation.mapfile"
      },
      "2": {
       "name": "constant.numeric.address.mapfile"
      },
      "3": {
       "name": "constant.numeric.size.mapfile"
      },
      "4": {
       "name": "constant.numeric.size.mapfile"
      }
     }
    },
    {
     "match": "^\\s+(0x[0-9a-fA-F]+)\\s+(\\(size before relaxing\\))\\s*$",
     "captures": {
      "1": {
       "name": "constant.numeric.size.mapfile"
      },
      "2": {
       "name": "comment.line.annotation.mapfile"
      }
     }
    },
    {
     "match": "^\\s+(\\[!provide\\])\\s+(PROVIDE_HIDDEN|PROVIDE)\\s*(\\()\\s*([A-Za-z_$][\\w.$]*)\\s*(=)\\s*(.*?)\\s*(\\))\\s*$",
     "captures": {
      "1": {
       "name": "comment.line.annotation.mapfile"
      },
      "2": {
       "name": "keyword.control.linker.mapfile"
      },
      "3": {
       "name": "punctuation.parens.mapfile"
      },
      "4": {
       "patterns": [
        {
         "include": "#sym-ref"
        }
       ]
      },
      "5": {
       "name": "keyword.operator.mapfile"
      },
      "6": {
       "patterns": [
        {
         "include": "#expr"
        }
       ]
      },
      "7": {
       "name": "punctuation.parens.mapfile"
      }
     }
    },
    {
     "match": "^\\s+(0x[0-9a-fA-F]+)\\s+(PROVIDE_HIDDEN|PROVIDE)\\s*(\\()\\s*([A-Za-z_$][\\w.$]*)\\s*(=)\\s*(.*?)\\s*(\\))\\s*$",
     "captures": {
      "1": {
       "name": "constant.numeric.address.mapfile"
      },
      "2": {
       "name": "keyword.control.linker.mapfile"
      },
      "3": {
       "name": "punctuation.parens.mapfile"
      },
      "4": {
       "patterns": [
        {
         "include": "#sym-ref"
        }
       ]
      },
      "5": {
       "name": "keyword.operator.mapfile"
      },
      "6": {
       "patterns": [
        {
         "include": "#expr"
        }
       ]
      },
      "7": {
       "name": "punctuation.parens.mapfile"
      }
     }
    },
    {
     "match": "^(/DISCARD/)\\s*(:)\\s*(\\{)(.*)(\\})\\s*$",
     "captures": {
      "1": {
       "name": "entity.name.section.output.mapfile"
      },
      "2": {
       "name": "keyword.operator.mapfile"
      },
      "3": {
       "name": "punctuation.parens.mapfile"
      },
      "4": {
       "patterns": [
        {
         "include": "#glob"
        }
       ]
      },
      "5": {
       "name": "punctuation.parens.mapfile"
      }
     }
    },
    {
     "match": "^(/DISCARD/)\\s*$",
     "captures": {
      "1": {
       "name": "entity.name.section.output.mapfile"
      }
     }
    },
    {
     "match": "^((?:Merging|Updated|Removed)\\b.*)$",
     "captures": {
      "1": {
       "name": "comment.line.annotation.mapfile"
      }
     }
    },
    {
     "match": "^#\\s*(Object files|Sections|Symbols|Dead Stripped Symbols):\\s*$",
     "captures": {
      "1": {
       "name": "markup.heading.mapfile"
      }
     }
    },
    {
     "match": "^#\\s*(Address\\b.*)$",
     "captures": {
      "1": {
       "name": "markup.underline.table-header.mapfile"
      }
     }
    },
    {
     "match": "^#\\s*(Path|Arch|Link map version|Platform)(:)\\s*(.*)$",
     "captures": {
      "1": {
       "name": "keyword.control.linker.mapfile"
      },
      "2": {
       "name": "keyword.operator.mapfile"
      },
      "3": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      }
     }
    },
    {
     "match": "^#.*$",
     "name": "comment.line.number-sign.mapfile"
    },
    {
     "match": "^(\\[\\s*\\d+\\])\\s+(linker synthesized)\\s*$",
     "captures": {
      "1": {
       "name": "constant.numeric.size.mapfile"
      },
      "2": {
       "name": "comment.line.annotation.mapfile"
      }
     }
    },
    {
     "match": "^(\\[\\s*\\d+\\])\\s+(.+)$",
     "captures": {
      "1": {
       "name": "constant.numeric.size.mapfile"
      },
      "2": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      }
     }
    },
    {
     "match": "^(0x[0-9a-fA-F]+)\\s+(0x[0-9a-fA-F]+)\\s+(\\[\\s*\\d+\\])\\s+(.*)$",
     "captures": {
      "1": {
       "name": "constant.numeric.address.mapfile"
      },
      "2": {
       "name": "constant.numeric.size.mapfile"
      },
      "3": {
       "name": "constant.numeric.size.mapfile"
      },
      "4": {
       "patterns": [
        {
         "include": "#apple-name"
        }
       ]
      }
     }
    },
    {
     "match": "^(0x[0-9a-fA-F]+)\\s+(0x[0-9a-fA-F]+)\\s+(\\S+)\\s+(\\S+)\\s*$",
     "captures": {
      "1": {
       "name": "constant.numeric.address.mapfile"
      },
      "2": {
       "name": "constant.numeric.size.mapfile"
      },
      "3": {
       "name": "entity.name.section.output.mapfile"
      },
      "4": {
       "name": "entity.name.section.input.mapfile"
      }
     }
    },
    {
     "match": "^([A-Za-z_.$][\\w.$-]*)\\s+(0x[0-9a-fA-F]+)\\s+(0x[0-9a-fA-F]+)(?:\\s+(load address)\\s+(0x[0-9a-fA-F]+))?",
     "captures": {
      "1": {
       "name": "entity.name.section.output.mapfile"
      },
      "2": {
       "name": "constant.numeric.address.mapfile"
      },
      "3": {
       "name": "constant.numeric.size.mapfile"
      },
      "4": {
       "name": "comment.line.annotation.mapfile"
      },
      "5": {
       "name": "constant.numeric.address.mapfile"
      }
     }
    },
    {
     "match": "^([A-Za-z_$][\\w.$]*)\\s+(0x[0-9a-fA-F]+)\\s+(\\S.*)$",
     "captures": {
      "1": {
       "name": "entity.name.function.symbol.mapfile"
      },
      "2": {
       "name": "constant.numeric.size.mapfile"
      },
      "3": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      }
     }
    },
    {
     "match": "^([A-Za-z_.$][\\w.$-]*)\\s*$",
     "captures": {
      "1": {
       "name": "entity.name.section.output.mapfile"
      }
     }
    },
    {
     "match": "^\\s+(\\*[^\\s(]*)(\\()(.*)(\\))\\s*$",
     "captures": {
      "1": {
       "patterns": [
        {
         "include": "#glob"
        }
       ]
      },
      "2": {
       "name": "punctuation.parens.mapfile"
      },
      "3": {
       "patterns": [
        {
         "include": "#glob"
        }
       ]
      },
      "4": {
       "name": "punctuation.parens.mapfile"
      }
     }
    },
    {
     "match": "^\\s+(0x[0-9a-fA-F]+)\\s+(\\.)\\s*(\\+?=)\\s*(.*)$",
     "captures": {
      "1": {
       "name": "constant.numeric.address.mapfile"
      },
      "2": {
       "name": "variable.language.location-counter.mapfile"
      },
      "3": {
       "name": "keyword.operator.mapfile"
      },
      "4": {
       "patterns": [
        {
         "include": "#expr"
        }
       ]
      }
     }
    },
    {
     "match": "^\\s+(0x[0-9a-fA-F]+)\\s+([A-Za-z_$][\\w.$]*)\\s*(=)\\s*(.*)$",
     "captures": {
      "1": {
       "name": "constant.numeric.address.mapfile"
      },
      "2": {
       "patterns": [
        {
         "include": "#sym-ref"
        }
       ]
      },
      "3": {
       "name": "keyword.operator.mapfile"
      },
      "4": {
       "patterns": [
        {
         "include": "#expr"
        }
       ]
      }
     }
    },
    {
     "match": "^\\s+(\\.?[A-Za-z_.$][\\w.$-]*)\\s+(0x[0-9a-fA-F]+)\\s+(0x[0-9a-fA-F]+)\\s*(.*)$",
     "captures": {
      "1": {
       "name": "entity.name.section.input.mapfile"
      },
      "2": {
       "name": "constant.numeric.address.mapfile"
      },
      "3": {
       "name": "constant.numeric.size.mapfile"
      },
      "4": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      }
     }
    },
    {
     "match": "^\\s+(\\.[A-Za-z_.$][\\w.$-]*)\\s*$",
     "captures": {
      "1": {
       "name": "entity.name.section.input.mapfile"
      }
     }
    },
    {
     "match": "^\\s+(0x[0-9a-fA-F]+)\\s+(0x[0-9a-fA-F]+)\\s+(\\S.*)$",
     "captures": {
      "1": {
       "name": "constant.numeric.address.mapfile"
      },
      "2": {
       "name": "constant.numeric.size.mapfile"
      },
      "3": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      }
     }
    },
    {
     "match": "^\\s+(0x[0-9a-fA-F]+)\\s+([\\w.$]+(?:@@?[\\w.]+)?)\\s*(.*)$",
     "captures": {
      "1": {
       "name": "constant.numeric.address.mapfile"
      },
      "2": {
       "patterns": [
        {
         "include": "#sym-ref"
        }
       ]
      },
      "3": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      }
     }
    },
    {
     "match": "^((?:[A-Za-z]:)?(?:[\\w.+~@-]*[/\\\\])*[\\w.+~@-]+\\.a)(\\()([^)]+)(\\))\\s*$",
     "captures": {
      "1": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      },
      "2": {
       "name": "punctuation.parens.mapfile"
      },
      "3": {
       "name": "entity.name.filename.object.mapfile"
      },
      "4": {
       "name": "punctuation.parens.mapfile"
      }
     }
    },
    {
     "match": "^\\s+(\\S+)\\s+(\\()(.+)(\\))\\s*$",
     "captures": {
      "1": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      },
      "2": {
       "name": "punctuation.parens.mapfile"
      },
      "3": {
       "patterns": [
        {
         "include": "#sym-ref"
        }
       ]
      },
      "4": {
       "name": "punctuation.parens.mapfile"
      }
     }
    },
    {
     "match": "^([A-Za-z_$][\\w.$]*)\\s+(\\S.*)$",
     "captures": {
      "1": {
       "patterns": [
        {
         "include": "#sym-ref"
        }
       ]
      },
      "2": {
       "patterns": [
        {
         "include": "#objref"
        }
       ]
      }
     }
    },
    {
     "include": "#expr"
    }
   ]
  }
 }
}
