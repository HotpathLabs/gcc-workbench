{
  "name": "gcc-syntax-highlighting",
  "displayName": "GCC Workbench (RTL, GIMPLE & MD)",
  "description": "The professional workspace for GCC engineers. Filter noise, navigate Machine description files, RTL/GIMPLE dumps, and visualize linker memory maps.",
  "version": "3.0.0",
  "author": {
    "name": "Kishan Parmar",
    "email": "kparmar2101@gmail.com",
    "url": "https://github.com/RegAlloc"
  },
  "publisher": "RegAlloc",
  "icon": "pictures/gcc.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HotpathLabs/gcc-workbench"
  },
  "bugs": {
    "url": "https://github.com/HotpathLabs/gcc-workbench/issues"
  },
  "homepage": "https://github.com/HotpathLabs/gcc-workbench",
  "_license": {
    "name": "GPL-3.0-or-later",
    "copyright": "Copyright (C) 2025 Kishan Parmar",
    "notice": "This file is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation; either version 3 of the License, or (at your option) any later version. This file is distributed WITHOUT ANY WARRANTY. See https://www.gnu.org/licenses/ for details."
  },
  "keywords": [
    "gcc",
    "gnu",
    "rtl",
    "gimple",
    "compiler",
    "gcc-internals",
    "compiler-internals",
    "machine-description",
    "match.pd",
    "ssa",
    "tree-ssa",
    "dataflow",
    "liveness",
    "cfg",
    "control-flow-graph",
    "optimization",
    "pass-dump",
    "language-server",
    "powerpc",
    "rs6000",
    "aarch64",
    "arm64",
    "embedded",
    "toolchain",
    "linker",
    "linker-script",
    "map-file",
    "memory-map",
    "stack-usage",
    "dejagnu"
  ],
  "engines": {
    "vscode": "^1.50.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "mocha \"out-test/test/**/*.test.js\""
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:gcc-md",
    "onLanguage:gcc-rtl",
    "onLanguage:gcc-gimple",
    "onLanguage:gcc-match",
    "onLanguage:rs6000-builtins",
    "onLanguage:rs6000-overload",
    "onLanguage:linkerscript",
    "onLanguage:mapfile",
    "onLanguage:c",
    "onLanguage:cpp",
    "onView:gcc-dump-explorer",
    "onCommand:gcc-workbench.viewSource",
    "workspaceContains:**/*.ld",
    "workspaceContains:**/*.map"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "gcc-md",
        "path": "./snippets/gcc-md.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gcc-explorer",
          "title": "GCC Explorer",
          "icon": "./pictures/gnu-dark.png"
        }
      ]
    },
    "views": {
      "gcc-explorer": [
        {
          "id": "gcc-dump-explorer",
          "name": "Compilation Passes"
        },
        {
          "id": "gcc-stack-usage.globalStackUsage",
          "name": "GCC Stack Usage"
        },
        {
          "id": "gcc-stack-usage.currentFileStackUsage",
          "name": "Current File Stack Usage"
        }
      ]
    },
    "commands": [
      {
        "command": "gcc-md.openFilePermanent",
        "title": "Open MD Include"
      },
      {
        "command": "gcc-dump.comparePreviousPass",
        "title": "Compare with Previous Pass",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gcc-dump.refreshPasses",
        "title": "Refresh Passes",
        "icon": "$(refresh)"
      },
      {
        "command": "gcc-dump.filterPasses",
        "title": "Filter Categories",
        "icon": "$(filter)"
      },
      {
        "command": "gcc-dump.toggleFocus",
        "title": "Hide Noise",
        "icon": "$(eye-closed)"
      },
      {
        "command": "gcc-dump.toggleFocus_on",
        "title": "Show Noise",
        "icon": "$(eye)"
      },
      {
        "command": "gcc-dump.openDotFile",
        "title": "Open Graph (CFG)",
        "icon": "$(layers-dot)"
      },
      {
        "command": "gcc-dump.nextPass",
        "title": "Next Pass",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gcc-dump.prevPass",
        "title": "Previous Pass",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gcc-workbench.viewSource",
        "title": "View Source (Split)",
        "icon": "$(file-code)"
      },
      {
        "command": "gcc-workbench.showMemoryMap",
        "title": "GCC: Show Memory Map",
        "icon": "$(graph)"
      },
      {
        "command": "gcc-workbench.refreshMemoryMap",
        "title": "GCC: Refresh Memory Map",
        "icon": "$(refresh)"
      },
      {
        "command": "gcc-stack-usage.updateSuStore",
        "title": "GCC: Reload Stack Usage Files",
        "icon": "$(refresh)"
      },
      {
        "command": "gcc-stack-usage.toggleEnabled",
        "title": "GCC: Toggle Stack Usage Analysis",
        "icon": "$(pulse)"
      },
      {
        "command": "gcc-workbench.findInMemoryMap",
        "title": "GCC: Find in Memory Map"
      }
    ],
    "keybindings": [
      {
        "command": "gcc-dump.prevPass",
        "key": "ctrl+alt+[",
        "mac": "ctrl+alt+[",
        "when": "editorTextFocus && resourceFilename =~ /\\.[0-9]{3}[tir]\\.[^.]+$/"
      },
      {
        "command": "gcc-dump.nextPass",
        "key": "ctrl+alt+]",
        "mac": "ctrl+alt+]",
        "when": "editorTextFocus && resourceFilename =~ /\\.[0-9]{3}[tir]\\.[^.]+$/"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gcc-stack-usage.toggleEnabled",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "navigation@0"
        },
        {
          "command": "gcc-dump.comparePreviousPass",
          "when": "resourceFilename =~ /\\.[0-9]{3}[tir]\\./",
          "group": "navigation@1"
        },
        {
          "command": "gcc-dump.toggleFocus",
          "when": "resourceFilename =~ /\\.[0-9]{3}[tir]\\.[^.]+$/ && !gcc-dump.focusModeActive",
          "group": "navigation@2"
        },
        {
          "command": "gcc-dump.toggleFocus_on",
          "when": "resourceFilename =~ /\\.[0-9]{3}[tir]\\.[^.]+$/ && gcc-dump.focusModeActive",
          "group": "navigation@2"
        },
        {
          "command": "gcc-dump.openDotFile",
          "when": "resourceFilename =~ /\\.[0-9]{3}[tir]\\.[^.]+$/",
          "group": "navigation@3"
        },
        {
          "command": "gcc-dump.prevPass",
          "group": "navigation@4",
          "when": "editorLangId == gcc-rtl || editorLangId == gcc-gimple"
        },
        {
          "command": "gcc-dump.nextPass",
          "group": "navigation@5",
          "when": "editorLangId == gcc-rtl || editorLangId == gcc-gimple"
        },
        {
          "command": "gcc-workbench.viewSource",
          "group": "navigation",
          "when": "resourceLangId =~ /gcc-rtl/"
        },
        {
          "command": "gcc-workbench.showMemoryMap",
          "group": "navigation@10",
          "when": "resourceExtname =~ /\\.(map|ld)$/"
        }
      ],
      "view/title": [
        {
          "command": "gcc-dump.refreshPasses",
          "when": "view == gcc-dump-explorer",
          "group": "navigation"
        },
        {
          "command": "gcc-dump.filterPasses",
          "when": "view == gcc-dump-explorer",
          "group": "navigation"
        },
        {
          "command": "gcc-stack-usage.updateSuStore",
          "when": "view == gcc-stack-usage.globalStackUsage && gcc-stack-usage.enabled",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "gcc-workbench.findInMemoryMap",
          "group": "navigation@100",
          "when": "gcc-workbench.hasMemoryLayout && resourceExtname =~ /\\.(c|cpp|cc|cxx|h|hpp|hxx|hh|s|S|asm|rs|zig|d)$/"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gcc-stack-usage.globalStackUsage",
        "contents": "Stack Usage Analysis is disabled.\n[Enable Stack Usage](command:gcc-stack-usage.toggleEnabled)",
        "when": "!gcc-stack-usage.enabled"
      },
      {
        "view": "gcc-stack-usage.globalStackUsage",
        "contents": "No .su files found.\nCompile with `-fstack-usage` flag and [reload](command:gcc-stack-usage.updateSuStore).",
        "when": "gcc-stack-usage.enabled"
      }
    ],
    "languages": [
      {
        "id": "linkerscript",
        "aliases": [
          "Linker Script",
          "ld"
        ],
        "extensions": [
          ".ld",
          ".lds"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rs6000-builtins",
        "aliases": [
          "GCC RS6000 Builtins"
        ],
        "filenames": [
          "rs6000-builtins.def"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./pictures/rs6000.png",
          "dark": "./pictures/rs6000.png"
        }
      },
      {
        "id": "rs6000-overload",
        "aliases": [
          "GCC RS6000 Overloads"
        ],
        "filenames": [
          "rs6000-overload.def"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./pictures/rs6000.png",
          "dark": "./pictures/rs6000.png"
        }
      },
      {
        "id": "markdown",
        "filenames": ["README.md", "TODO.md", "CHANGELOG.md"]
      },
      {
        "id": "gcc-md",
        "aliases": [
          "GCC Machine Description",
          "gcc-md"
        ],
        "extensions": [
          ".md"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./pictures/gnu-dark.png",
          "dark": "./pictures/gnu-light.png"
        }
      },
      {
        "id": "gcc-rtl",
        "aliases": [
          "GCC RTL Dump"
        ],
        "filenamePatterns": [
          "**/*.[0-9][0-9][0-9]r.[^.]*"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./pictures/gnu-dark.png",
          "dark": "./pictures/gnu-light.png"
        }
      },
      {
        "id": "gcc-gimple",
        "aliases": [
          "GCC Gimple"
        ],
        "filenamePatterns": [
          "**/*.[0-9][0-9][0-9]t.[^.]*",
          "**/*.[0-9][0-9][0-9]i.[^.]*"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./pictures/gnu-dark.png",
          "dark": "./pictures/gnu-light.png"
        }
      },
      {
        "id": "gcc-match",
        "aliases": [
          "GCC MatchPD"
        ],
        "extensions": [
          ".pd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./pictures/gnu-dark.png",
          "dark": "./pictures/gnu-light.png"
        }
      },
      {
        "id": "gcc-exp",
        "aliases": [
          "GCC Expression"
        ],
        "extensions": [
          ".exp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./pictures/gnu-dark.png",
          "dark": "./pictures/gnu-light.png"
        }
      },
      {
        "id": "gcc-opt",
        "aliases": [
          "GCC Options"
        ],
        "extensions": [
          ".opt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./pictures/gnu-dark.png",
          "dark": "./pictures/gnu-light.png"
        }
      },
      {
        "id": "mapfile",
        "aliases": [
          "Linker Map File",
          "Map File"
        ],
        "extensions": [
          ".map"
        ],
        "configuration": "./language-configurations/mapfile.json",
        "icon": {
          "light": "./pictures/gnu-dark.png",
          "dark": "./pictures/gnu-light.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "linkerscript",
        "scopeName": "source.linkerscript",
        "path": "./syntaxes/linkerscript.tmLanguage.json"
      },
      {
        "language": "rs6000-builtins",
        "scopeName": "source.gcc.rs6000",
        "path": "./syntaxes/rs6000-builtins.tmLanguage.json"
      },
      {
        "language": "rs6000-overload",
        "scopeName": "source.gcc.rs6000-overload",
        "path": "./syntaxes/rs6000-overload.tmLanguage.json"
      },
      {
        "language": "gcc-md",
        "scopeName": "source.gcc.md",
        "path": "./syntaxes/md.tmLanguage.json"
      },
      {
        "language": "gcc-rtl",
        "scopeName": "source.gcc.rtl",
        "path": "./syntaxes/rtl.tmLanguage.json"
      },
      {
        "language": "gcc-gimple",
        "scopeName": "source.gcc.gimple",
        "path": "./syntaxes/gimple.tmLanguage.json"
      },
      {
        "language": "gcc-match",
        "scopeName": "source.gcc.match",
        "path": "./syntaxes/match.tmLanguage.json"
      },
      {
        "language": "gcc-exp",
        "scopeName": "source.gcc.exp",
        "path": "./syntaxes/exp.tmLanguage.json"
      },
      {
        "language": "gcc-opt",
        "scopeName": "source.gcc.opt",
        "path": "./syntaxes/opt.tmLanguage.json"
      },
      {
        "language": "mapfile",
        "scopeName": "source.mapfile",
        "path": "./syntaxes/mapfile.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[gcc-md]": {
        "editor.tabSize": 8,
        "editor.detectIndentation": false,
        "editor.action.changeTabDisplaySize": 8,
        "editor.semanticHighlighting.enabled": true
      },
      "[gcc-match]": {
        "editor.tabSize": 8,
        "editor.detectIndentation": false,
        "editor.action.changeTabDisplaySize": 8
      },
      "files.associations": {
        "t-*": "makefile",
        "x-*": "makefile",
        "config.in": "cpp",
        "config.*": "shellscript",
        "*.dot": "dot",
        "*.svg": "svg"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "markup.heading.mapfile",
            "settings": {
              "foreground": "#F0A04B",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "markup.underline.table-header.mapfile",
            "settings": {
              "foreground": "#9DA5B4",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.type.region.mapfile",
            "settings": {
              "foreground": "#E6C229",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "storage.modifier.attribute.mapfile",
            "settings": {
              "foreground": "#F28FAD"
            }
          },
          {
            "scope": "constant.language.default.mapfile",
            "settings": {
              "foreground": "#9DA5B4",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "entity.name.section.output.mapfile",
            "settings": {
              "foreground": "#4A9EE8",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.section.input.mapfile",
            "settings": {
              "foreground": "#3FB8A0"
            }
          },
          {
            "scope": "constant.numeric.address.mapfile",
            "settings": {
              "foreground": "#7CB36A"
            }
          },
          {
            "scope": "constant.numeric.size.mapfile",
            "settings": {
              "foreground": "#E5786D"
            }
          },
          {
            "scope": "entity.name.function.symbol.mapfile",
            "settings": {
              "foreground": "#E0AF68"
            }
          },
          {
            "scope": "support.variable.builtin.mapfile",
            "settings": {
              "foreground": "#FF7AC6",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "entity.name.function.imported.mapfile",
            "settings": {
              "foreground": "#6FD0E8"
            }
          },
          {
            "scope": "variable.other.version.mapfile",
            "settings": {
              "foreground": "#8B9BB4",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "entity.name.filename.object.mapfile",
            "settings": {
              "foreground": "#8EA8C8"
            }
          },
          {
            "scope": "entity.name.filename.library.mapfile",
            "settings": {
              "foreground": "#B39DDB",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.filename.shared.mapfile",
            "settings": {
              "foreground": "#6FD0E8"
            }
          },
          {
            "scope": "string.unquoted.directory.mapfile",
            "settings": {
              "foreground": "#7D8590"
            }
          },
          {
            "scope": "keyword.control.linker.mapfile",
            "settings": {
              "foreground": "#D96FD0",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "support.function.linker.mapfile",
            "settings": {
              "foreground": "#56B6C2"
            }
          },
          {
            "scope": "support.constant.linker.mapfile",
            "settings": {
              "foreground": "#D19A66"
            }
          },
          {
            "scope": "comment.line.annotation.mapfile",
            "settings": {
              "foreground": "#7F8FA9",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "comment.line.number-sign.mapfile",
            "settings": {
              "foreground": "#7F8FA9",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "variable.language.location-counter.mapfile",
            "settings": {
              "foreground": "#FFB86C",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.operator.mapfile",
            "settings": {
              "foreground": "#9DA5B4"
            }
          },
          {
            "scope": "string.quoted.double.mapfile",
            "settings": {
              "foreground": "#98C379"
            }
          },
          {
            "scope": "string.unquoted.mapfile",
            "settings": {
              "foreground": "#8EA8C8"
            }
          },
          {
            "scope": "keyword.rtl-memory.gcc.rtl",
            "settings": {
              "foreground": "#E8A33D",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "constant.other.memory-attr.gcc.rtl",
            "settings": {
              "foreground": "#C98F3A",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "entity.name.type.iterator.gcc-md",
            "settings": {
              "foreground": "#3FC6A8",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "variable.other.attribute.gcc-md",
            "settings": {
              "foreground": "#7AA2F7"
            }
          },
          {
            "scope": "storage.modifier.flag.gcc.rtl",
            "settings": {
              "foreground": "#D98CC4",
              "fontStyle": "italic"
            }
          }
        ]
      }
    },
    "semanticTokenTypes": [
      {
        "id": "gccIterator",
        "superType": "enum",
        "description": "Machine description iterator (define_*_iterator)"
      },
      {
        "id": "gccAttribute",
        "superType": "property",
        "description": "Machine description iterator attribute (define_*_attr)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gcc-md",
        "scopes": {
          "gccIterator": [
            "entity.name.type.iterator.gcc-md"
          ],
          "gccAttribute": [
            "variable.other.attribute.gcc-md"
          ]
        }
      }
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.50.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
